{
  "expo": {
    "name": "ASG-Production",
    "slug": "asg-production",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "asgproduction",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.asgproduction.app",
      "permissions": [
        "AUDIO_RECORDING",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4EBD3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "ASG Production",
      "shortName": "ASG",
      "themeColor": "#F1EBE1",
      "backgroundColor": "#F1EBE1",
      "display": "standalone",
      "scope": "/",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EBD3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan aplikasi ASG untuk mengakses galeri foto guna mengirim gambar di chat.",
          "cameraPermission": "Izinkan aplikasi ASG untuk mengakses kamera guna mengambil foto secara langsung."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "de5b343d-79ad-436b-9298-2dbb018d51e2"
      }
    }
  }
}